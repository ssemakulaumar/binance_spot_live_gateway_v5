# Default is paper. Set mode explicitly for testnet/live.
export BINANCE_MODE=paper

# TESTNET credentials (used only when BINANCE_MODE=testnet)
export BINANCE_TESTNET_API_KEY="your_testnet_key"
export BINANCE_TESTNET_API_SECRET="your_testnet_secret"

# REAL LIVE credentials (used only when BINANCE_MODE=live)
# Use a dedicated API key, enable Spot trading only, disable withdrawals,
# restrict by IP, and never share credentials.
export BINANCE_LIVE_API_KEY="your_live_key"
export BINANCE_LIVE_API_SECRET="your_live_secret"

export BOT_RISK_FRACTION=0.005
export BOT_MAX_ALLOCATION=0.10
export BOT_MAX_DAILY_LOSS=0.02
